@model Revayat.Web.Models.LoginViewModel
@{ ViewBag.Title = "ورود"; }
<div class="login-wrap"><div class="login-card"><div class="login-mark"><img src="/Content/img/revayat-mark.svg" alt="" /><h1>ورود به روایت</h1><p>برای ادامه وارد حساب خود شوید.</p></div>
@using (Html.BeginForm("Login", "Account", new { returnUrl = ViewBag.ReturnUrl }, FormMethod.Post)) {
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "form-error" })
    <label>نام کاربری @Html.TextBoxFor(m => m.UserName, new { autocomplete = "username" }) @Html.ValidationMessageFor(m => m.UserName)</label>
    <label>رمز عبور @Html.PasswordFor(m => m.Password, new { autocomplete = "current-password" }) @Html.ValidationMessageFor(m => m.Password)</label>
    <label class="remember">@Html.CheckBoxFor(m => m.RememberMe) مرا به خاطر بسپار</label>
    <button type="submit" class="button button-gold">ورود <i class="fa fa-arrow-left"></i></button>
}
<p class="account-switch">حساب ندارید؟ <a href="/Account/Register">ثبت‌نام کنید</a></p>
<a href="/" class="back-home">بازگشت به صفحه اصلی</a></div></div>
@section Scripts { @Scripts.Render("~/bundles/jqueryval") }