@model Revayat.Web.Models.ChangePasswordViewModel
@{ ViewBag.Title = "تغییر رمز عبور"; }
<div class="login-wrap"><div class="login-card"><div class="login-mark"><h1>تغییر رمز عبور</h1><p>برای امنیت حساب، رمز تازه انتخاب کنید.</p></div>
@using (Html.BeginForm()) {
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "form-error" })
    <label>رمز فعلی @Html.PasswordFor(m => m.CurrentPassword, new { autocomplete = "current-password" }) @Html.ValidationMessageFor(m => m.CurrentPassword)</label>
    <label>رمز جدید @Html.PasswordFor(m => m.NewPassword, new { autocomplete = "new-password" }) @Html.ValidationMessageFor(m => m.NewPassword)</label>
    <p class="password-hint">حداقل ۱۲ کاراکتر، شامل حرف بزرگ، حرف کوچک و عدد انگلیسی</p>
    <label>تکرار رمز جدید @Html.PasswordFor(m => m.ConfirmPassword, new { autocomplete = "new-password" }) @Html.ValidationMessageFor(m => m.ConfirmPassword)</label>
    <button type="submit" class="button button-gold">ذخیره رمز جدید</button>
}
<a href="/Account/Profile" class="back-home">بازگشت به حساب</a></div></div>
@section Scripts { @Scripts.Render("~/bundles/jqueryval") }