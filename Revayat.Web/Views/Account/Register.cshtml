@model Revayat.Web.Models.RegisterViewModel
@{ ViewBag.Title = "ثبت‌نام"; }
<div class="login-wrap"><div class="login-card"><div class="login-mark"><img src="/Content/img/revayat-mark.svg" alt="" /><h1>عضویت در روایت</h1><p>برای ثبت دیدگاه و مدیریت حساب، عضو شوید.</p></div>
@using (Html.BeginForm()) {
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "form-error" })
    <label>نام کاربری @Html.TextBoxFor(m => m.UserName, new { autocomplete = "username" }) @Html.ValidationMessageFor(m => m.UserName)</label>
    <label>ایمیل @Html.TextBoxFor(m => m.Email, new { type = "email", autocomplete = "email" }) @Html.ValidationMessageFor(m => m.Email)</label>
    <label>رمز عبور @Html.PasswordFor(m => m.Password, new { autocomplete = "new-password" }) @Html.ValidationMessageFor(m => m.Password)</label>
    <p class="password-hint">حداقل ۱۲ کاراکتر، شامل حرف بزرگ، حرف کوچک و عدد انگلیسی</p>
    <label>تکرار رمز عبور @Html.PasswordFor(m => m.ConfirmPassword, new { autocomplete = "new-password" }) @Html.ValidationMessageFor(m => m.ConfirmPassword)</label>
    <button type="submit" class="button button-gold">ایجاد حساب <i class="fa fa-arrow-left"></i></button>
}
<p class="account-switch">قبلاً عضو شده‌اید؟ <a href="/Account/Login">وارد شوید</a></p></div></div>
@section Scripts { @Scripts.Render("~/bundles/jqueryval") }