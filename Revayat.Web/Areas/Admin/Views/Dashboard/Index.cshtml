@model Revayat.Web.Areas.Admin.Models.DashboardViewModel
@{ ViewBag.Title = "داشبورد"; var max = Math.Max(1, Model.DailyArticles.Max()); }
<div class="admin-page-heading"><div><h1>سلام، به روایت خوش آمدید</h1><p>نمایی از محتوای منتشرشده و فعالیت سامانه</p></div><a href="/Admin/Pages/Create" class="admin-primary"><i class="fa fa-plus"></i> ایجاد مقاله جدید</a></div>
<div class="stats-grid">
<div class="stat-card"><span class="stat-icon teal"><i class="fa fa-file-text-o"></i></span><span>مقاله‌های منتشرشده</span><strong>@Model.ArticleCount.ToString("N0")</strong></div>
<div class="stat-card"><span class="stat-icon gold"><i class="fa fa-comments-o"></i></span><span>دیدگاه‌ها</span><strong>@Model.CommentCount.ToString("N0")</strong></div>
<div class="stat-card"><span class="stat-icon gold"><i class="fa fa-clone"></i></span><span>دسته‌بندی‌ها</span><strong>@Model.GroupCount.ToString("N0")</strong></div>
<div class="stat-card"><span class="stat-icon teal"><i class="fa fa-eye"></i></span><span>کل بازدیدها</span><strong>@Model.TotalVisits.ToString("N0")</strong></div>
</div>
<div class="dashboard-grid">
<section class="admin-panel chart-panel"><div class="panel-heading"><h2><i class="fa fa-bar-chart"></i> انتشار محتوا در هفت روز گذشته</h2></div><div class="bar-chart" role="img" aria-label="نمودار تعداد مقاله‌های منتشرشده در هفت روز گذشته">@for (var i = 0; i < 7; i++) { <div class="bar-column"><span>@Model.DailyArticles[i]</span><div class="bar-track"><div class="bar-fill" style="height:@(Math.Max(4, Model.DailyArticles[i] * 100 / max))%"></div></div><small>@Model.DayLabels[i]</small></div> }</div></section>
<section class="admin-panel quick-panel"><div class="panel-heading"><h2><i class="fa fa-bolt"></i> دسترسی سریع</h2></div><div class="quick-grid"><a href="/Admin/Pages/Create"><i class="fa fa-plus"></i> مقاله جدید</a><a href="/Admin/Pages"><i class="fa fa-pencil"></i> مدیریت مقاله‌ها</a><a href="/Admin/PageGroups"><i class="fa fa-folder-o"></i> دسته‌بندی‌ها</a><a href="/"><i class="fa fa-external-link"></i> مشاهده سایت</a></div></section>
</div>
<section class="admin-panel"><div class="panel-heading"><h2><i class="fa fa-list"></i> آخرین مقاله‌ها</h2><a href="/Admin/Pages">مشاهده همه <i class="fa fa-arrow-left"></i></a></div>@if (Model.RecentArticles.Any()) { <div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>عنوان مقاله</th><th>دسته‌بندی</th><th>تاریخ انتشار</th><th>بازدید</th><th>عملیات</th></tr></thead><tbody>@foreach (var item in Model.RecentArticles) { <tr><td><div class="table-title"><img src="/PageImages/@item.ImageName" alt="" /><strong>@item.Title</strong></div></td><td><span class="table-pill">@(item.PageGroup != null ? item.PageGroup.GroupTitle : "—")</span></td><td>@item.CreateDate.ToShamsi()</td><td>@item.Visit</td><td><a href="/Admin/Pages/Edit/@item.PageID">ویرایش</a></td></tr> }</tbody></table></div> } else { <p class="admin-empty">هنوز مقاله‌ای منتشر نشده است. با ایجاد اولین مقاله، فهرست اینجا نمایش داده می‌شود.</p> }</section>